{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-wasm": "mkdir -p public/js && cp -f ../js/bandage-layout.{js,wasm} ../js/bandage-layout-wrapper.js ../js/bandage-layout-worker-interface.js ../js/bandage-layout.worker.js public/js/ 2>/dev/null || echo 'WASM files not found - run layout_wasm/build.sh from the repository root first'",
    "predev": "npm run copy-wasm",
    "dev": "vite",
    "prebuild": "npm run copy-wasm",
    "build": "vite build",
    "lint": "eslint .",
    "prepreview": "npm run copy-wasm",
    "preview": "vite preview",
    "predeploy": "yarn build",
    "deploy": "aws s3 sync dist s3://jbrowse.org/demos/bandagejs",
    "postdeploy": "aws cloudfront create-invalidation --distribution-id E13LGELJOT4GQO --paths \"/demos/bandagejs/*\""
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.10.31",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
